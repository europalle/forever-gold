generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// An item as TSM names it. The id is the game's item ID.
model Item {
  id        Int      @id
  name      String
  updatedAt DateTime @updatedAt

  marketPrices MarketPrice[]
  regionStats  RegionStat[]
}

enum SnapshotKind {
  MARKET // one auction house: region, ruleset and faction
  REGION // every ruleset and faction in a region together
}

// One TSM file as it was on fetch. A file is stored once per `sourceUpdatedAt`,
// the scan time TSM writes into every row, so polling more often than TSM
// publishes costs nothing.
model Snapshot {
  id              Int          @id @default(autoincrement())
  kind            SnapshotKind
  scope           String // "eu-pvp-alliance" or "eu"
  sourceUpdatedAt DateTime
  fetchedAt       DateTime     @default(now())
  etag            String?
  itemCount       Int

  marketPrices MarketPrice[]
  regionStats  RegionStat[]

  @@unique([kind, scope, sourceUpdatedAt])
  @@index([kind, scope, fetchedAt])
}

// A row of the market file. Copper. A null price means TSM had none: for
// minBuyout and recent, nothing was listed at scan time.
model MarketPrice {
  snapshotId  Int
  itemId      Int
  marketValue Int?
  minBuyout   Int?
  recent      Int?
  historical  Int?

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@id([snapshotId, itemId])
  @@index([itemId])
}

// A row of the region file. Copper, except saleRate (share of posted auctions
// that sell, 0 to 1) and soldPerDay (units sold per auction house per day).
model RegionStat {
  snapshotId   Int
  itemId       Int
  marketValue  Int?
  historical   Int?
  avgSalePrice Int?
  saleRate     Float?
  soldPerDay   Float?

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@id([snapshotId, itemId])
  @@index([itemId])
}

enum Role {
  ADMIN
  MEMBER
}

// A person who signs in. Admins create accounts; there is no sign-up. Everyone
// is in one guild, so everyone shares one market (src/config/player.ts).
model User {
  id             String    @id @default(cuid())
  username       String    @unique // lower case
  displayName    String
  passwordHash   String
  role           Role      @default(MEMBER)
  // Bumped on password change: signs out every other session.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  characters Character[]
  ledger     LedgerEntry[]
  gold       GoldSample[]
  uploads    Upload[]

  devices        Device[]
  invoices       AhInvoice[]
  lootEvents     LootEvent[]
  invitesCreated Invite[] @relation("InvitesCreated")
  inviteUsed     Invite[] @relation("InviteUsed")
}

// A character as TSM's file describes it. Skills come from TSM's profession
// list, which leaves out gathering professions.
model Character {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  faction     String
  realm       String // the ruleset name TSM uses, e.g. "PvP"
  classKey    String?
  money       Int? // copper, as of the last upload
  professions Json     @default("{}") // { "Leatherworking": { "level": 105, "maxLevel": 150 } }
  // From the Forever Gold addon (gathering professions included there).
  level       Int?
  inventory   Json     @default("{}") // { bags: { itemId: count }, bank: {...}, mail: {...} }
  auctions    Json     @default("[]") // [{ id, n, buyout, bid, left }]
  recipes     Json     @default("{}") // { profession: { recipeId: { name, out, qty, reag: [[id, qty]], cd } } }
  addonAt     DateTime?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, faction, realm])
}

enum LedgerKind {
  SALE
  BUY
  EXPIRED
  CANCELLED
  INCOME
  EXPENSE
}

// TSM's accounting rows, kept for good: TSM trims its own history over time.
model LedgerEntry {
  id          Int        @id @default(autoincrement())
  userId      String
  kind        LedgerKind
  realm       String
  character   String
  itemString  String // "" for income and expense
  itemId      Int?
  stackSize   Int
  quantity    Int
  unitPrice   Int // copper per unit, sales and buys
  amount      Int // copper, income and expense
  detail      String // sale or buy source, or income or expense type
  otherPlayer String
  time        DateTime
  fingerprint String // identity across uploads, see fingerprints()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, kind, time])
  @@index([userId, itemId])
}

// TSM's gold log: a character's gold at a moment.
model GoldSample {
  userId    String
  character String
  faction   String
  realm     String
  at        DateTime
  copper    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, character, realm, at])
}

model Upload {
  id      Int      @id @default(autoincrement())
  userId  String
  kind    String // "tsm"
  bytes   Int
  newRows Int
  at      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, at])
}

// A one-time sign-up link. Only a SHA-256 of the token is stored; the link is
// shown to the admin once. Used or expired invites cannot create accounts.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  note        String    @default("") // who it is for, for the admin's list
  role        Role      @default(MEMBER)
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?

  createdBy User  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

// A paired helper program. It sends a bearer token; only its SHA-256 is stored.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Item details from the game, sent by members' addons (GetItemInfo). Shared by
// everyone: they are game data, not personal. TSM's price files have none of this.
model ItemInfo {
  id         Int      @id
  name       String?
  quality    Int? // 0 poor, 1 common, 2 uncommon, 3 rare, 4 epic
  itemLevel  Int?
  reqLevel   Int?
  classId    Int? // Enum.ItemClass: 2 weapon, 4 armor, 7 trade goods, 9 recipe, ...
  subclassId Int?
  equipLoc   String?
  vendorSell Int? // copper
  maxStack   Int?
  bindType   Int? // 0 none, 1 on pickup, 2 on equip, 3 on use, 4 quest
  icon       String? // image URL from Blizzard's media endpoint
  iconTried  DateTime? // when the icon was last asked for, found or not
  updatedAt  DateTime @updatedAt
}

// An auction house sale mail as the addon read it: the real cut and deposit.
model AhInvoice {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String // the addon's content key, so re-uploads add nothing
  time      DateTime
  character String
  itemName  String
  quantity  Int
  buyout    Int
  bid       Int
  deposit   Int
  cut       Int
  net       Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// What a loot window held, recorded by members' addons: corpse loot,
// skinning, gathering, fishing and disenchanting. Pooled across the guild for
// drop rates and disenchant odds.
model LootEvent {
  id           Int      @id @default(autoincrement())
  userId       String
  key          String // content key, so re-uploads add nothing
  time         DateTime
  kind         String // loot, skin, herb, mine, fish, disenchant
  npcId        Int?
  npcName      String?
  npcLevel     Int?
  mapId        Int?
  sourceItemId Int? // the item a disenchant used up
  items        Json // [[itemId, quantity], ...]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([kind, npcId])
  @@index([kind, sourceItemId])
}

// What a vendor sells, as last seen by any member. Game data, shared.
model VendorItem {
  npcId      Int
  itemId     Int
  vendorName String?
  mapId      Int?
  price      Int // copper for `stack` units
  stack      Int
  stock      Int? // limited stock, if any
  extended   Boolean  @default(false) // costs something besides gold
  seenAt     DateTime

  @@id([npcId, itemId])
  @@index([itemId])
}

// What a trainer teaches, as last seen by any member. Game data, shared.
model TrainerService {
  npcId       Int
  name        String
  trainerName String?
  mapId       Int?
  cost        Int?
  skill       String?
  skillLevel  Int?
  levelReq    Int?
  itemId      Int?
  category    String?
  seenAt      DateTime

  @@id([npcId, name])
  @@index([itemId])
}

// Small site-wide settings, e.g. which Blizzard auction house is ours.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// One Blizzard auction house listing, keyed by its Last-Modified time.
model DepthSnapshot {
  id           Int      @id @default(autoincrement())
  houseId      Int
  lastModified DateTime
  fetchedAt    DateTime @default(now())
  itemCount    Int
  auctionCount Int

  items DepthItem[]

  @@unique([houseId, lastModified])
}

// Per item in a listing: the cheapest unit price, how many are listed at it
// and within 5% of it, all units listed, and the cheapest price steps.
model DepthItem {
  snapshotId  Int
  itemId      Int
  minUnit     Int
  qtyAtMin    Int
  qtyNearMin  Int
  totalQty    Int
  auctions    Int
  ladder      Json // [[unit price, quantity], ...] cheapest first, up to 8 steps

  snapshot DepthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, itemId])
  @@index([itemId])
}

// Units listed and the cheapest unit price, every three hours or so, for 30
// days: the supply history behind the signals (DepthItem keeps only 72 hours).
model SupplyPoint {
  itemId   Int
  at       DateTime
  minUnit  Int
  totalQty Int

  @@id([itemId, at])
  @@index([at])
}

// The current signal per item, rebuilt after each collection (src/lib/signal-run.ts).
model ItemSignal {
  itemId       Int      @id
  at           DateTime
  condition    String // CRASH, FLOOD, SQUEEZE, SPIKE, SLIDE, DIP, RICH, UPTREND, CALM
  action       String // buy, sell, hold, wait, none
  strength     Int // 0, 1, 2 (strong)
  reason       String
  price        Int
  fair         Int
  expected     Int
  change24     Float?
  slope        Float?
  z            Float
  supplyRatio  Float?
  supplyChange Float?
  liquid       Boolean
  soldPerDay   Float?
  soldHere     Float? // units a day on this auction house, from ItemFlow
  daysCover    Float? // units listed divided by soldHere

  @@index([action, strength])
}

// Each new call when it first appears, for the live track record.
model SignalEvent {
  id        Int      @id @default(autoincrement())
  itemId    Int
  at        DateTime
  condition String
  action    String
  strength  Int
  price     Int
  fair      Int

  @@index([itemId, at])
  @@index([at])
}

// Units bought per item per UTC day on our auction house, estimated from what
// left the cheap end between Blizzard listings (soldBetween). FlowDay holds how
// many hours of each day were observed, so a rate can be worked out.
model ItemFlow {
  itemId Int
  day    DateTime @db.Date
  sold   Int

  @@id([itemId, day])
  @@index([day])
}

model FlowDay {
  day   DateTime @id @db.Date
  hours Float
}

// Every recipe of every profession, from Blizzard's game data (src/lib/static-import.ts).
model Recipe {
  id         Int      @id // Blizzard's recipe id
  profession String
  tier       String?
  category   String?
  name       String
  outputId   Int? // null for recipes that make no item (enchants)
  outputQty  Float    @default(1)
  reagents   Json     @default("[]") // [[itemId, quantity], ...]
  fetchedAt  DateTime? // null until its details are in

  @@index([profession])
  @@index([outputId])
}

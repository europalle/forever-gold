# Postgres for the app at runtime. Any of DATABASE_URL, POSTGRES_URL or
# POSTGRES_PRISMA_URL works; the first plain postgres:// string is used.
DATABASE_URL="postgresql://postgres@localhost:5433/forever_gold?host=/tmp"

# Optional direct (non-pooled) connection for migrations. Vercel's integrations
# may call it DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING; any works.
DATABASE_URL_DIRECT=""

# The one password for the site.
APP_PASSWORD=""

# Signs the login cookie. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=""

# Optional: lets a scheduler call /api/cron/collect with
# "Authorization: Bearer <secret>". Not needed if GitHub Actions collects.
CRON_SECRET=""

# Postgres connection string the app uses at runtime. A pooled URL is fine here.
DATABASE_URL="postgresql://postgres@localhost:5433/forever_gold?host=/tmp"

# Optional direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=""

# Shared secret for the collector endpoint, /api/cron/collect. Long random string.
# The scheduler sends it as "Authorization: Bearer <secret>".
CRON_SECRET=""
